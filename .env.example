# ============================================================
# TATAME OS — variáveis de ambiente
# Copie para .env.local no seu computador,
# e configure as mesmas na Vercel em Settings > Environment Variables
# ============================================================

# --- NUVEM (opcional: sem isso o app funciona 100% offline) ---
# Supabase > Settings > API
# ATENÇÃO: use SEMPRE a chave "anon public". A "service_role" NUNCA
# pode ir para o frontend — ela ignora todas as regras de segurança.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-public

# --- IA (opcional) ---
# Esta NÃO tem prefixo VITE_ de propósito: ela fica só no servidor,
# usada pela função /api/ia. Nunca chega no navegador.
GROQ_API_KEY=cole-aqui-a-chave-da-groq

# Monitoramento de erro (opcional). Sem isso o app funciona igual,
# você só não fica sabendo quando algo quebra no aparelho de alguém.
VITE_SENTRY_DSN=
VITE_APP_VERSION=9.2.0
